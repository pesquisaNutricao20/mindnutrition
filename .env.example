# ---------------------------------------------------------------------------
# Servidor (NUNCA use o prefixo VITE_ em segredos: VITE_ é exposto no navegador)
# ---------------------------------------------------------------------------

# IA — Groq (texto: openai/gpt-oss-120b; visão: qwen/qwen3.8-27b)
GROQ_API_KEY=
# Opcionais: sobrescrevem os modelos padrão
# GROQ_TEXT_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# IA — fallback de texto na NVIDIA (usado quando a Groq falha/limita ou não está configurada)
NVIDIA_API_KEY=
# NVIDIA_TEXT_MODEL=minimaxai/minimax-m3.1-flash

# Supabase no servidor (service role NUNCA vai para o cliente)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin — gere o hash com: npm run admin:hash -- "sua-senha-forte"
# Formato: scrypt$N$r$p$salt$key
ADMIN_KEY_HASH=
# Alternativa legada (texto puro): use apenas temporariamente
# ADMIN_KEY=
# Segredo do cookie de sessão (recomendado; senão é derivado do hash)
# ADMIN_SESSION_SECRET=
# Validade da sessão em horas (padrão 8, máximo 72)
# ADMIN_SESSION_TTL_HOURS=8

# Rede
APP_URL=http://localhost:3000
# Ative atrás de proxy reverso (Vercel já é detectado automaticamente)
# TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Cliente (público — chave anon/publishable do Supabase)
# ---------------------------------------------------------------------------
VITE_PUBLICSUPABASE_URL=
VITE_PUBLICSUPABASE_ANON_KEY=
